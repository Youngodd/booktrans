# Copy to .env and edit. Leave DOMAIN empty to test over plain HTTP on the server's IP.
DOMAIN=
# Parallel jobs (each uses up to ~1-2 GB while it works); use 1 on a 2 GB server.
BOOKTRANS_WORKERS=2
BOOKTRANS_MAX_UPLOAD_MB=60
BOOKTRANS_MAX_PAGES=400
BOOKTRANS_RETENTION_HOURS=24

# WeChat mini program login. Signing key: any long random string (keep it stable,
# or users must log in again after each restart). AppID/AppSecret: MP console -> Development settings.
BOOKTRANS_SECRET=
WX_APPID=
WX_SECRET=
# Email the finished PDF (optional). Port 465 = SSL, other ports use STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

page { background: #faf7f2; color: #1d1b18; font-size: 30rpx; line-height: 1.5; }
.wrap { padding: 32rpx; }
h1, .title { font-size: 44rpx; font-weight: 700; margin-bottom: 8rpx; }
.sub { color: #6b645a; font-size: 26rpx; margin-bottom: 32rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; }
.label { font-size: 26rpx; color: #6b645a; margin: 20rpx 0 8rpx; }
.input { border: 1rpx solid #d9d2c5; border-radius: 10rpx; padding: 16rpx 20rpx; background: #fff; }
.btn { background: #8a3b1e; color: #fff; border-radius: 12rpx; margin-top: 24rpx; }
.btn[disabled] { opacity: 0.5; }
.btn.plain { background: #fff; color: #8a3b1e; border: 1rpx solid #8a3b1e; }
.error { color: #b3261e; margin-top: 16rpx; }
.bar { height: 16rpx; background: #e9e3d8; border-radius: 8rpx; overflow: hidden; margin: 20rpx 0; }
.bar view { height: 100%; background: #8a3b1e; }

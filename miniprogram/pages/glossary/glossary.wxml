<view class="wrap">
  <view class="title">人名与术语译法</view>
  <view class="sub">整本书会统一使用这里的译名。可以直接修改；把译名清空表示不指定。</view>

  <view class="card" wx:if="{{state === 'building' || state === ''}}">
    <view>正在整理人名术语...</view>
    <view class="sub">需要几十秒，请稍等。</view>
  </view>

  <view class="card" wx:if="{{state === 'failed'}}">
    <view class="error">{{error}}</view>
    <button class="btn plain" bindtap="back">返回</button>
  </view>

  <block wx:if="{{state === 'ready'}}">
    <view class="card" wx:if="{{!entries.length}}">
      <view class="sub">没有找到需要统一的人名或术语。你也可以在下面手动添加。</view>
    </view>
    <view class="card" wx:if="{{entries.length}}">
      <view class="row" wx:for="{{entries}}" wx:key="term" wx:for-index="i">
        <view class="term">{{item.term}}</view>
        <input class="input zh" value="{{item.zh}}" data-term="{{item.term}}" data-index="{{i}}" bindinput="onEdit" placeholder="中文译名" />
      </view>
    </view>

    <view class="card">
      <view class="label">添加一条</view>
      <input class="input" value="{{newTerm}}" bindinput="onNewTerm" placeholder="英文原文，如 Boyle" />
      <input class="input" style="margin-top:12rpx" value="{{newZh}}" bindinput="onNewZh" placeholder="中文译名，如 波义耳" />
      <button class="btn plain" bindtap="add">添加</button>
    </view>

    <button class="btn" bindtap="save" disabled="{{busy}}">{{busy ? '保存中...' : '保存并返回'}}</button>
  </block>

  <view class="error" wx:if="{{error && state !== 'failed'}}">{{error}}</view>
</view>

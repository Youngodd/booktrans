<view class="wrap">
  <view class="title">Book Translator</view>
  <view class="sub">English book in, bilingual PDF out. You use your own API key.</view>

  <view class="card">
    <button class="btn plain" bindtap="pickFile" disabled="{{busy}}">
      {{job ? 'Choose another book' : 'Choose a book from WeChat chat'}}
    </button>
    <view class="sub" wx:if="{{!job}}" style="margin-top:16rpx">
      PDF, EPUB or TXT. Send the file to "File Transfer" first, then pick it here.
    </view>
    <view wx:if="{{job}}" style="margin-top:20rpx">
      <view>{{job.filename}}</view>
      <view class="sub">{{job.pages_total}} pages</view>
    </view>
  </view>

  <view class="card" wx:if="{{job}}">
    <view class="label">Supplier</view>
    <picker range="{{providers}}" range-key="name" value="{{providerIndex}}" bindchange="onProvider">
      <view class="input">{{providers[providerIndex].name}}</view>
    </picker>
    <view class="label">API key (used for this job only, never stored)</view>
    <input class="input" password value="{{apiKey}}" bindinput="onKey" placeholder="{{providers[providerIndex].hint}}" />
    <view class="label">Pages (optional, e.g. 1-20)</view>
    <input class="input" value="{{pages}}" bindinput="onPages" placeholder="whole book" />
    <view class="label" wx:if="{{emailEnabled}}">Email the PDF to (optional)</view>
    <input class="input" wx:if="{{emailEnabled}}" type="text" value="{{email}}" bindinput="onEmail" placeholder="you@example.com" />
    <view style="margin-top:20rpx">
      <switch checked="{{preview}}" bindchange="onPreview"/> Try only the first 3 pages
    </view>
    <view style="margin-top:12rpx">
      <switch checked="{{ocr}}" bindchange="onOcr"/> Scanned book (OCR)
    </view>
    <button class="btn" bindtap="start" disabled="{{busy}}">{{busy ? 'Working...' : 'Start translating'}}</button>
  </view>

  <view class="error" wx:if="{{error}}">{{error}}</view>
</view>
